# ------------------------------------------------------------------
# Mamta General Store — environment template
#
# Only PUBLIC variables are used. There is no service-role key and no
# database password in this app: admin operations run under the signed-in
# admin's session and are authorized by Row Level Security policies
# (supabase/migrations/0007_rls_policies.sql).
#
# The same values serve the React Native/Expo app — either variable naming
# works here (Next.js names shown; EXPO_PUBLIC_SUPABASE_URL and
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY are equally accepted).
# ------------------------------------------------------------------

# Supabase project URL (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable/anon key (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of this site (SEO metadata, sitemap, robots)
# Public origin of the deployed site - REQUIRED in production (the app
# refuses to start without it there). Used for canonical URLs, sitemap.xml,
# robots.txt and Open Graph. Never leave it pointing at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# n8n webhook URL (fire-and-forget on checkout)
N8N_WEBHOOK_URL=


