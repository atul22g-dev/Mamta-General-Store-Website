# Admin credentials for `npm run db:backup` (optional).
# Copy to scripts/backup.env (gitignored) and fill in an ADMIN user's
# Supabase Auth credentials — the backup then includes orders, order_items
# and profiles. Without this file, only the anon-readable catalog
# (categories, products, images, sizes, colors) is backed up.
SUPABASE_BACKUP_EMAIL=
SUPABASE_BACKUP_PASSWORD=
