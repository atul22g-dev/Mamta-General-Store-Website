# ------------------------------------------------------------------
# Maintenance-script connection (used ONLY by `npm run db:deploy`).
#
# Copy this file to scripts/db.env and paste your connection string:
#
#   cp scripts/db.env.example scripts/db.env
#
# Supabase dashboard → Project Settings → Database → Connection string → URI
#
# This file is gitignored. The Next.js app itself never reads it — .env
# keeps holding public variables only.
#
# If the password contains special characters (like @), keep them
# URL-encoded exactly as the dashboard shows them.
# ------------------------------------------------------------------

# Direct connection (IPv6 networks):
#DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Session pooler (works on IPv4-only networks — pick your project's region):
#DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
